# Desenvolvimento local. Troque SECRET_KEY por um valor exclusivo antes de publicar.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-local-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Sem DATABASE_URL, o backend usa SQLite local (db.sqlite3).
# Em produção, configure DATABASE_URL para PostgreSQL no ambiente do host.
DATABASE_URL=
# Para docker-compose.yml, configure também POSTGRES_PASSWORD com valor próprio.
POSTGRES_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173

# O comando seed_admin só cria a conta se ambos estiverem preenchidos.
# Configure uma senha individual forte no ambiente; não a publique.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador HydroTech

# Opcional: utilitário create_user.py para conta comum de demonstração.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NOME=Usuário de Demonstração

# Opcional: descrição de rios via Gemini. Sem chave, o endpoint usa fallback local.
GEMINI_API_KEY=

JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7
LOG_LEVEL=INFO
