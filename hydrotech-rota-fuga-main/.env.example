# API do HydroTech (só usamos as rotas públicas, de leitura)
HYDROTECH_API_URL=http://127.0.0.1:8000

# Chave opcional do openrouteservice.org. Configure só no FastAPI, nunca no Vue.
# Com ela a rota tenta desviar das áreas de risco;
# sem ela a rota sai pelo OSRM e só avisa se passar por alguma área.
ORS_API_KEY=

RAIO_ZONA_RISCO_M=300
MARGEM_DESTINO_M=200
DISTANCIA_MAX_ZONA_M=20000
CANDIDATOS_ROTA=3
CANDIDATOS_ROTA_SEM_DESVIO=5
TIMEOUT_ROTA_S=10
TIMEOUT_PEDIDO_S=40
CACHE_ZONAS_S=60
RAIO_PREAQUECER_ALTITUDE_M=3500
MAX_PONTOS_PREAQUECER=20000
INTERVALO_PREAQUECER_S=300
